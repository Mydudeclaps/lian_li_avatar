+    if let Some(encoded_frames) = pngs.or(jpegs) {
+        if encoded_frames.is_empty() {
+            return true;
+        }
+        let idx = idx.min(encoded_frames.len() - 1);
+        if !ensure_decoded(state, idx, &clip_key, &encoded_frames) {
+            return true;
+        }
+        let Some((frame, opaque)) = state
+            .video_frame_cache
+            .as_ref()
