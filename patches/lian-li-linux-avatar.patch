+/// Rotate tightly-packed RGBA pixels into `out`, reusing its allocation.
+/// Tiled so strided reads stay cache-resident; the image-crate rotate on the
+/// render hot path cost an extra full-frame input copy plus a cache-hostile
+/// full-frame traversal per frame.
+fn rotate_rgba_into(src: &[u8], w: usize, h: usize, rot: u16, out: &mut Vec<u8>) {
+    const TILE: usize = 64;
+    out.clear();
+    out.resize(src.len(), 0);
+    match rot {
+        // dst is h wide, w tall; dst(dx, dy) = src(dy, h - 1 - dx)
+        90 => {
+            for by in (0..w).step_by(TILE) {
+                for bx in (0..h).step_by(TILE) {
+                    for dy in by..(by + TILE).min(w) {
+                        for dx in bx..(bx + TILE).min(h) {
+                            let d = (dy * h + dx) * 4;
+                            let s = ((h - 1 - dx) * w + dy) * 4;
+                            out[d..d + 4].copy_from_slice(&src[s..s + 4]);
+                        }
+                    }
+                }
+            }
+        }
+        // dst is h wide, w tall; dst(dx, dy) = src(w - 1 - dy, dx)
+        270 => {
+            for by in (0..w).step_by(TILE) {
+                for bx in (0..h).step_by(TILE) {
+                    for dy in by..(by + TILE).min(w) {
+                        for dx in bx..(bx + TILE).min(h) {
+                            let d = (dy * h + dx) * 4;
+                            let s = (dx * w + (w - 1 - dy)) * 4;
+                            out[d..d + 4].copy_from_slice(&src[s..s + 4]);
+                        }
+                    }
+                }
+            }
+        }
+        // same dims; dst(dx, dy) = src(w - 1 - dx, h - 1 - dy)
+        _ => {
+            for dy in 0..h {
+                for dx in 0..w {
+                    let d = (dy * w + dx) * 4;
+                    let s = ((h - 1 - dy) * w + (w - 1 - dx)) * 4;
+                    out[d..d + 4].copy_from_slice(&src[s..s + 4]);
+                }
+            }
+        }
+    }
 }
 
