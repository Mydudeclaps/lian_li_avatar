+
+impl VideoFrameCache {
+    /// Per-frame size above which only the latest frame is kept.
+    pub const SINGLE_FRAME_BYTES: usize = 4 << 20;
+    /// Total decoded bytes kept per widget before the cache resets.
+    pub const MAX_BYTES: usize = 48 << 20;
+
+    pub fn get(&self, clip_key: &str, idx: usize) -> Option<&(RgbaImage, bool)> {
+        if self.clip_key == clip_key {
+            self.frames.get(&idx)
+        } else {
+            None
+        }
+    }
+
+    pub fn insert(&mut self, clip_key: &str, idx: usize, frame: RgbaImage, opaque: bool) {
+        let frame_bytes = frame.as_raw().len();
+        if self.clip_key != clip_key
+            || frame_bytes >= Self::SINGLE_FRAME_BYTES
+            || self.bytes + frame_bytes > Self::MAX_BYTES
+        {
+            self.frames.clear();
+            self.bytes = 0;
+            self.clip_key = clip_key.to_string();
+        }
+        self.bytes += frame_bytes;
+        self.frames.insert(idx, (frame, opaque));
+        self.last_idx = idx;
+    }
