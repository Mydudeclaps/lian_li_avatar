+#[derive(Clone, Copy, Debug, PartialEq)]
+struct VideoPositionCommand {
+    seq: u64,
+    center: [f32; 2],
+    duration_ms: u64,
+}
+
+fn parse_video_position_command(value: &str) -> Option<VideoPositionCommand> {
+    let mut fields = value.split_ascii_whitespace();
+    if fields.next()? != "v1" {
+        return None;
+    }
+    let seq = fields.next()?.parse().ok()?;
+    let center_x: f32 = fields.next()?.parse().ok()?;
+    let center_y: f32 = fields.next()?.parse().ok()?;
+    let duration_ms = fields.next()?.parse().ok()?;
+    if fields.next().is_some() || !center_x.is_finite() || !center_y.is_finite() {
+        return None;
+    }
+    Some(VideoPositionCommand {
+        seq,
+        center: [center_x, center_y],
+        duration_ms,
+    })
+}
+
+fn clamp_video_position(center: [f32; 2], template: &LcdTemplate) -> [f32; 2] {
+    fn clamp_axis(value: f32, canvas_extent: u32) -> f32 {
+        if canvas_extent == 0 {
+            return value;
+        }
+        value.clamp(0.0, canvas_extent as f32)
+    }
+
+    [
+        clamp_axis(center[0], template.base_width),
+        clamp_axis(center[1], template.base_height),
+    ]
+}
+
+fn position_pixel(center: [f32; 2], uniform_scale: f32) -> [i32; 2] {
+    [
+        (center[0] * uniform_scale).round() as i32,
+        (center[1] * uniform_scale).round() as i32,
+    ]
+}
+
+fn advance_video_position(state: &mut WidgetState, elapsed_ms: u64, uniform_scale: f32) -> bool {
+    let previous_pixel = position_pixel(state.video_position_current, uniform_scale);
+    let linear = if state.video_position_duration_ms == 0 {
+        1.0
+    } else {
+        elapsed_ms
+            .saturating_sub(state.video_position_epoch_ms)
+            .min(state.video_position_duration_ms) as f64
+            / state.video_position_duration_ms as f64
+    };
+    let smooth = linear * linear * (3.0 - 2.0 * linear);
+    for axis in 0..2 {
+        state.video_position_current[axis] = state.video_position_from[axis]
+            + (state.video_position_to[axis] - state.video_position_from[axis]) * smooth as f32;
+    }
+    position_pixel(state.video_position_current, uniform_scale) != previous_pixel
+}
+
+fn apply_video_position_command(
+    state: &mut WidgetState,
+    command: VideoPositionCommand,
+    target: [f32; 2],
+    elapsed_ms: u64,
+    uniform_scale: f32,
+) -> bool {
+    if state.video_position_seq == Some(command.seq) {
+        return false;
+    }
+
+    let previous_pixel = position_pixel(state.video_position_current, uniform_scale);
+    state.video_position_from = state.video_position_current;
+    state.video_position_to = target;
+    state.video_position_seq = Some(command.seq);
+    state.video_position_epoch_ms = elapsed_ms;
+    state.video_position_duration_ms = command.duration_ms;
+    if command.duration_ms == 0 {
+        state.video_position_current = target;
+    }
+    position_pixel(state.video_position_current, uniform_scale) != previous_pixel
+}
+
+fn activate_video_variant(
+    state: &mut WidgetState,
+    selected: Option<String>,
+    elapsed_ms: u64,
+    crossfade_ms: u64,
+) {
+    let previous_render = state.cached_render.take();
+    state.active_video_variant = selected;
+    state.video_clip_epoch_ms = elapsed_ms;
+    state.last_video_frame_idx = None;
+    state.last_video_render_ms = None;
+    state.video_frame_cache = None;
+    state.cached_render_key = None;
+    state.video_transition = if crossfade_ms == 0 {
+        None
+    } else {
+        previous_render.map(|from_overlay| VideoTransition {
+            from_overlay,
+            started_ms: elapsed_ms,
+            duration_ms: crossfade_ms,
+            mix: 0,
+        })
+    };
+}
+
+fn transition_mix(started_ms: u64, duration_ms: u64, elapsed_ms: u64) -> Option<u8> {
+    let transition_elapsed = elapsed_ms.saturating_sub(started_ms);
+    if duration_ms == 0 || transition_elapsed >= duration_ms {
+        return None;
+    }
+    let numerator = transition_elapsed as u128 * u8::MAX as u128;
+    Some((numerator / duration_ms as u128) as u8)
+}
+
+fn advance_video_transition(state: &mut WidgetState, elapsed_ms: u64) -> bool {
+    let Some(transition) = state.video_transition.as_mut() else {
+        return false;
+    };
+    match transition_mix(transition.started_ms, transition.duration_ms, elapsed_ms) {
+        Some(mix) if mix != transition.mix => {
+            transition.mix = mix;
+            true
+        }
+        Some(_) => false,
+        None => {
+            state.video_transition = None;
+            state.cached_render = None;
+            state.cached_render_key = None;
+            true
+        }
+    }
+}
