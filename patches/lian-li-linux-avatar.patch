+/// Interpolate two straight-alpha RGBA overlays in premultiplied-alpha space.
+///
+/// Interpolating straight RGB values darkens antialiased edges when one side
+/// is transparent. Premultiplication keeps the visible color stable while the
+/// alpha changes.
+pub fn premultiplied_crossfade(from: &RgbaImage, to: &RgbaImage, mix: u8) -> RgbaImage {
+    if mix == 0 {
+        return from.clone();
+    }
+    if mix == u8::MAX || from.dimensions() != to.dimensions() {
+        return to.clone();
+    }
+
+    let t = mix as u32;
+    let inverse_t = 255 - t;
+    let mut output = RgbaImage::new(to.width(), to.height());
+    for ((out, from), to) in output.pixels_mut().zip(from.pixels()).zip(to.pixels()) {
+        let from_alpha = from[3] as u32;
+        let to_alpha = to[3] as u32;
+        let alpha_denominator = from_alpha * inverse_t + to_alpha * t;
+        if alpha_denominator == 0 {
+            *out = Rgba([0, 0, 0, 0]);
+            continue;
+        }
+
+        for channel in 0..3 {
+            let numerator =
+                from[channel] as u32 * from_alpha * inverse_t + to[channel] as u32 * to_alpha * t;
+            out[channel] = ((numerator + alpha_denominator / 2) / alpha_denominator) as u8;
+        }
+        out[3] = ((alpha_denominator + 127) / 255) as u8;
+    }
+    output
+}
