+/// Per-row runs of non-transparent pixels, as (start, end) pixel columns.
+pub type RowSpans = Vec<Vec<(u32, u32)>>;
+
+/// Precompute the non-transparent runs of a cached overlay so repeat blits
+/// can skip fully-transparent pixels entirely. Returns None when the overlay
+/// is small (plain blit is already cheap) or dense (span bookkeeping would
+/// not pay for itself).
+pub fn compute_overlay_spans(src: &RgbaImage) -> Option<RowSpans> {
+    const MIN_AREA: u32 = 1 << 16;
+    const MERGE_GAP: u32 = 16;
+    const MAX_COVERAGE: f32 = 0.85;
+
+    let (w, h) = (src.width(), src.height());
+    if (w as u64) * (h as u64) < MIN_AREA as u64 {
+        return None;
+    }
+
+    let buf: &[u8] = src.as_raw();
+    let mut spans: RowSpans = Vec::with_capacity(h as usize);
+    let mut covered: u64 = 0;
+    for y in 0..h as usize {
+        let row = &buf[y * w as usize * 4..(y + 1) * w as usize * 4];
+        let mut runs: Vec<(u32, u32)> = Vec::new();
+        let mut run_start: Option<u32> = None;
+        let mut last_visible: u32 = 0;
+        for (x, px) in row.chunks_exact(4).enumerate() {
+            if px[3] != 0 {
+                let x = x as u32;
+                match run_start {
+                    None => run_start = Some(x),
+                    Some(_) if x > last_visible + MERGE_GAP => {
+                        runs.push((run_start.take().unwrap(), last_visible + 1));
+                        run_start = Some(x);
+                    }
+                    _ => {}
                 }
-                let half = denom / 2;
-                dpx[0] = ((sa * sr * 255 + da * inv * dr + half) / denom) as u8;
-                dpx[1] = ((sa * sg * 255 + da * inv * dg + half) / denom) as u8;
-                dpx[2] = ((sa * sb * 255 + da * inv * db + half) / denom) as u8;
-                dpx[3] = ((denom + 127) / 255) as u8;
+                last_visible = x;
+            }
+        }
+        if let Some(start) = run_start {
+            runs.push((start, last_visible + 1));
+        }
+        covered += runs.iter().map(|(a, b)| (b - a) as u64).sum::<u64>();
+        spans.push(runs);
+    }
+
+    if covered as f32 / (w as u64 * h as u64) as f32 > MAX_COVERAGE {
+        return None;
+    }
+    Some(spans)
+}
