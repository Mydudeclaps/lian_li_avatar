+/// Overlay `src` onto `dst` when every `src` pixel is known to be fully
+/// opaque (e.g. a JPEG-decoded video frame): rows are block-copied instead of
+/// alpha-blended per pixel.
+pub fn fast_overlay_opaque(dst: &mut RgbaImage, src: &RgbaImage, tl_x: i64, tl_y: i64) {
+    let dw = dst.width() as i64;
+    let dh = dst.height() as i64;
+    let sw = src.width() as i64;
+    let sh = src.height() as i64;
+
+    let dx0 = tl_x.max(0);
