+
+    #[test]
+    fn parses_versioned_position_command_strictly() {
+        assert_eq!(
+            parse_video_position_command("v1 42 1200.5 700 900\n"),
+            Some(VideoPositionCommand {
+                seq: 42,
+                center: [1200.5, 700.0],
+                duration_ms: 900,
+            })
+        );
+        for invalid in [
+            "",
+            "v2 42 1200 700 900",
+            "v1 nope 1200 700 900",
+            "v1 42 NaN 700 900",
+            "v1 42 1200 inf 900",
+            "v1 42 1200 700",
+            "v1 42 1200 700 900 extra",
+        ] {
+            assert_eq!(parse_video_position_command(invalid), None, "{invalid}");
+        }
+    }
+
+    #[test]
+    fn position_center_uses_full_logical_canvas() {
+        let template = template();
+        assert_eq!(
+            clamp_video_position([-100.0, 5000.0], &template),
+            [0.0, 1048.0]
+        );
+        assert_eq!(
+            clamp_video_position([180.0, 720.0], &template),
+            [180.0, 720.0]
+        );
+        assert_eq!(
+            clamp_video_position([2108.0, 720.0], &template),
+            [2108.0, 720.0]
+        );
+    }
+
+    #[test]
+    fn interrupted_position_motion_continues_from_current_point() {
+        let mut state = WidgetState::blank();
+        state.video_position_from = [100.0, 100.0];
+        state.video_position_to = [100.0, 100.0];
+        state.video_position_current = [100.0, 100.0];
+
+        let first = VideoPositionCommand {
+            seq: 1,
+            center: [300.0, 100.0],
+            duration_ms: 1000,
+        };
+        assert!(!apply_video_position_command(
+            &mut state,
+            first,
+            first.center,
+            0,
+            1.0
+        ));
+        assert!(advance_video_position(&mut state, 500, 1.0));
+        assert_eq!(state.video_position_current, [200.0, 100.0]);
+
+        let second = VideoPositionCommand {
+            seq: 2,
+            center: [400.0, 100.0],
+            duration_ms: 1000,
+        };
+        assert!(!apply_video_position_command(
+            &mut state,
+            second,
+            second.center,
+            500,
+            1.0
+        ));
+        assert_eq!(state.video_position_from, [200.0, 100.0]);
+        assert!(advance_video_position(&mut state, 1000, 1.0));
+        assert_eq!(state.video_position_current, [300.0, 100.0]);
+
+        assert!(!apply_video_position_command(
+            &mut state,
+            second,
+            second.center,
+            1000,
+            1.0
+        ));
+    }
+
+    #[test]
+    fn selector_change_snapshots_render_and_completes_crossfade() {
+        let outgoing = RgbaImage::from_pixel(2, 1, Rgba([20, 40, 60, 200]));
+        let mut state = WidgetState::blank();
+        state.cached_render = Some(outgoing.clone());
+        state.cached_render_key = Some(7);
+        state.video_frame_cache = Some(("old".into(), 3, RgbaImage::new(2, 1)));
+
+        activate_video_variant(&mut state, Some("new".into()), 100, 250);
+
+        assert_eq!(state.active_video_variant.as_deref(), Some("new"));
+        assert!(state.cached_render.is_none());
+        assert!(state.cached_render_key.is_none());
+        assert!(state.video_frame_cache.is_none());
+        let transition = state.video_transition.as_ref().expect("transition");
+        assert_eq!(transition.from_overlay, outgoing);
+        assert_eq!(transition.mix, 0);
+
+        assert!(advance_video_transition(&mut state, 225));
+        assert_eq!(
+            state.video_transition.as_ref().map(|fade| fade.mix),
+            Some(127)
+        );
+        assert!(advance_video_transition(&mut state, 350));
+        assert!(state.video_transition.is_none());
+    }
+
+    #[test]
+    fn transition_progress_is_overflow_safe() {
+        assert_eq!(transition_mix(0, 250, 0), Some(0));
+        assert_eq!(transition_mix(0, 250, 125), Some(127));
+        assert_eq!(transition_mix(0, 250, 250), None);
+        assert_eq!(transition_mix(0, u64::MAX, u64::MAX - 1), Some(254));
+    }
+
+    #[test]
+    fn selector_alpha_clips_use_lossless_encoded_store() {
+        let frame = RgbaImage::from_pixel(2, 1, Rgba([10, 20, 30, 128]));
+        let png = encode_rgba_frames_to_png(vec![frame]).expect("encode source");
+        let temp = tempdir().expect("temporary directory");
+        let path = temp.path().join("selector.png");
+        std::fs::write(&path, &png[0]).expect("write source");
+
+        let selector_clip =
+            decode_video_clip(&path, Some(10.0), 2, 1, true).expect("selector clip");
+        assert!(selector_clip.frames.is_none());
+        assert!(selector_clip.frames_png.is_some());
+        assert!(selector_clip.frames_jpeg.is_none());
+
+        let legacy_clip = decode_video_clip(&path, Some(10.0), 2, 1, false).expect("legacy clip");
+        assert!(legacy_clip.frames.is_some());
+        assert!(legacy_clip.frames_png.is_none());
+        assert!(legacy_clip.frames_jpeg.is_none());
+    }
