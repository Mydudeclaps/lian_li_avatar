+mod tests {
+    use super::{decode_frames_to_rgba, encode_rgba_frames_to_png};
+    use image::{Rgba, RgbaImage};
+    use std::path::Path;
+
+    #[test]
+    fn lossless_png_frame_store_round_trips_rgba_exactly() {
+        let mut frame = RgbaImage::new(3, 2);
+        let pixels = [
+            Rgba([255, 0, 0, 255]),
+            Rgba([0, 255, 0, 128]),
+            Rgba([7, 11, 13, 0]),
+            Rgba([0, 0, 255, 64]),
+            Rgba([240, 200, 160, 1]),
+            Rgba([1, 2, 3, 254]),
+        ];
+        for (dst, src) in frame.pixels_mut().zip(pixels) {
+            *dst = src;
+        }
+
+        let encoded =
+            encode_rgba_frames_to_png(vec![frame.clone()]).expect("encode lossless frame");
+        assert_eq!(encoded.len(), 1);
+        let decoded = image::load_from_memory(&encoded[0])
+            .expect("decode stored frame")
+            .to_rgba8();
+        assert_eq!(decoded, frame);
+    }
+
