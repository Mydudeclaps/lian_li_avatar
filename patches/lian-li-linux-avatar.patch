+        ));
+        let (frames, durations) = decode_frames_to_rgba(path, 30.0, 200, 200).expect("decode APNG");
+        assert!(frames.len() > 1);
+        assert_eq!(frames.len(), durations.len());
+
+        let expected = frames.clone();
+        let encoded = encode_rgba_frames_to_png(frames).expect("encode APNG frames");
+        assert_eq!(encoded.len(), expected.len());
+        for (index, (png, expected)) in encoded.iter().zip(&expected).enumerate() {
+            let decoded = image::load_from_memory(png)
+                .unwrap_or_else(|error| panic!("decode stored frame {index}: {error}"))
+                .to_rgba8();
+            assert_eq!(&decoded, expected, "frame {index}");
+        }
+    }
+}
