+///
+/// Interpolating straight RGB values darkens antialiased edges when one side
+/// is transparent. Premultiplication keeps the visible color stable while the
+/// alpha changes.
+pub fn premultiplied_crossfade(from: &RgbaImage, to: &RgbaImage, mix: u8) -> RgbaImage {
+    if mix == 0 {
+        return from.clone();
+    }
+    if mix == u8::MAX || from.dimensions() != to.dimensions() {
+        return to.clone();
+    }
