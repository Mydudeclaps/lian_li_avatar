+            for (rot, reference) in [
+                (90u16, rotate90(&img).into_raw()),
+                (180, rotate180(&img).into_raw()),
+                (270, rotate270(&img).into_raw()),
+            ] {
+                rotate_rgba_into(img.as_raw(), w as usize, h as usize, rot, &mut out);
+                assert_eq!(out, reference, "rot {rot} mismatch at {w}x{h}");
+            }
+        }
+    }
+}
