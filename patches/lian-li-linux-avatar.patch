+/// Losslessly encode fully composited RGBA frames as independent PNG images.
+///
+/// Selector-backed animations keep these compressed bytes in memory and
+/// decode only the currently displayed frame. Independent PNGs preserve APNG
+/// alpha/blend/disposal results while avoiding a full-canvas RGBA allocation
+/// for every inactive variant.
+pub fn encode_rgba_frames_to_png(frames: Vec<RgbaImage>) -> Result<Vec<Vec<u8>>, MediaError> {
+    let mut encoded = Vec::with_capacity(frames.len());
+    for frame in frames {
+        let mut png = Vec::new();
+        PngEncoder::new_with_quality(&mut png, PngCompressionType::Fast, PngFilterType::Adaptive)
+            .write_image(
+            frame.as_raw(),
+            frame.width(),
+            frame.height(),
+            ExtendedColorType::Rgba8,
+        )?;
+        encoded.push(png);
+    }
+    Ok(encoded)
+}
+
