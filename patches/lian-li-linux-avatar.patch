+/// Like `fast_overlay`, but touches only the precomputed non-transparent
+/// runs of `src`.
+pub fn fast_overlay_with_spans(
+    dst: &mut RgbaImage,
+    src: &RgbaImage,
+    tl_x: i64,
+    tl_y: i64,
+    spans: &RowSpans,
+) {
+    let dw = dst.width() as i64;
+    let dh = dst.height() as i64;
+    let sw = src.width() as i64;
+    let sh = src.height() as i64;
+
+    let dy0 = tl_y.max(0);
+    let dy1 = (tl_y + sh).min(dh);
+    if dy0 >= dy1 {
+        return;
+    }
+
+    let dst_stride = dst.width() as usize * 4;
+    let src_stride = src.width() as usize * 4;
+    let dst_buf: &mut [u8] = dst.as_mut();
+    let src_buf: &[u8] = src.as_raw();
+
+    for dy in dy0..dy1 {
+        let sy = (dy - tl_y) as usize;
+        for &(rx0, rx1) in &spans[sy] {
+            // Clip the run against the destination bounds.
+            let dx0 = (tl_x + rx0 as i64).max(0);
+            let dx1 = (tl_x + rx1 as i64).min(dw).min(tl_x + sw);
+            if dx0 >= dx1 {
+                continue;
+            }
+            let run_px = (dx1 - dx0) as usize;
+            let d = dy as usize * dst_stride + dx0 as usize * 4;
+            let s = sy * src_stride + (dx0 - tl_x) as usize * 4;
+            let dst_row = &mut dst_buf[d..d + run_px * 4];
+            let src_row = &src_buf[s..s + run_px * 4];
+            for (dpx, spx) in dst_row.chunks_exact_mut(4).zip(src_row.chunks_exact(4)) {
+                blend_pixel(dpx, spx);
             }
         }
     }
 }
 
+#[inline(always)]
+fn blend_pixel(dpx: &mut [u8], spx: &[u8]) {
+    let sa = spx[3] as u32;
+    if sa == 0 {
+        return;
+    }
+    if sa == 255 {
+        dpx[0] = spx[0];
+        dpx[1] = spx[1];
+        dpx[2] = spx[2];
+        dpx[3] = 255;
+        return;
+    }
+    let inv = 255 - sa;
+    let da = dpx[3] as u32;
+    let sr = spx[0] as u32;
+    let sg = spx[1] as u32;
+    let sb = spx[2] as u32;
+    let dr = dpx[0] as u32;
+    let dg = dpx[1] as u32;
+    let db = dpx[2] as u32;
+    if da == 255 {
+        dpx[0] = ((sr * sa + dr * inv + 127) / 255) as u8;
+        dpx[1] = ((sg * sa + dg * inv + 127) / 255) as u8;
+        dpx[2] = ((sb * sa + db * inv + 127) / 255) as u8;
+    } else {
+        let denom = sa * 255 + da * inv;
+        if denom == 0 {
+            return;
+        }
+        let half = denom / 2;
+        dpx[0] = ((sa * sr * 255 + da * inv * dr + half) / denom) as u8;
+        dpx[1] = ((sa * sg * 255 + da * inv * dg + half) / denom) as u8;
+        dpx[2] = ((sa * sb * 255 + da * inv * db + half) / denom) as u8;
+        dpx[3] = ((denom + 127) / 255) as u8;
+    }
+}
