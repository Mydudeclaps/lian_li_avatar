+fn decode_video_clip(
+    path: &Path,
+    requested_fps: Option<f32>,
+    width: u32,
+    height: u32,
+    encode_alpha_frames: bool,
+) -> Result<VideoClip, MediaError> {
+    let decode_fps = crate::video::cap_fps_to_source(path, requested_fps.unwrap_or(30.0));
+    let ext = path
+        .extension()
+        .and_then(|e| e.to_str())
+        .map(|s| s.to_ascii_lowercase())
+        .unwrap_or_default();
+    let (frames, frames_png, frames_jpeg, durations) =
+        if ext == "gif" || ext == "png" || ext == "apng" {
+            let (frames, durations) =
+                decode_frames_to_rgba(path, decode_fps, width.max(1), height.max(1))?;
+            if encode_alpha_frames {
+                (
+                    None,
+                    Some(Arc::new(encode_rgba_frames_to_png(frames)?)),
+                    None,
+                    durations,
+                )
+            } else {
+                (Some(Arc::new(frames)), None, None, durations)
+            }
+        } else {
+            let (frames, durations) =
+                crate::video::decode_frames_to_jpeg(path, decode_fps, width.max(1), height.max(1))?;
+            (None, None, Some(Arc::new(frames)), durations)
+        };
+    let total_ms = durations
+        .iter()
+        .map(|d| d.as_millis() as u64)
+        .sum::<u64>()
+        .max(1);
+    Ok(VideoClip {
+        frames,
+        frames_png,
+        frames_jpeg,
+        frame_durations: Arc::new(durations),
+        total_ms,
+        fps_cap_ms: requested_fps.map(|_| (1000.0 / decode_fps.max(1.0)).round() as u64),
+    })
+}
