+
+    fn template() -> LcdTemplate {
+        LcdTemplate {
+            id: "test".into(),
+            name: "Test".into(),
+            base_width: 2288,
+            base_height: 1048,
+            background: TemplateBackground::default(),
+            widgets: Vec::new(),
+            rotated: false,
+            target_device: None,
